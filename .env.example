# --- Bot-side vars (used by the separate Discord bot repo, NOT this server) ---
DISCORD_BOT_TOKEN=
NEXUS_API_KEY=

# --- Server-side vars (used by THIS Nexus AI engine server) ---
# Ollama endpoint reachable from wherever this server is hosted (e.g. a Cloudflare Tunnel
# fronting Ollama on a home/local machine). Optional — if unset or unreachable, the server
# transparently falls back to its built-in template/retrieval response system.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
