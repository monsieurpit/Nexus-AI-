# --- Bot-side vars (used by the separate Discord bot repo, NOT this server) ---
DISCORD_BOT_TOKEN=
NEXUS_API_KEY=

# --- Server-side vars (used by THIS Nexus AI engine server) ---
# Ollama endpoint reachable from wherever this server is hosted (e.g. a Cloudflare Quick Tunnel
# to a local Ollama instance) — leave blank to disable real generation and use template fallback.
OLLAMA_BASE_URL=
# Main model. Requires it to be pulled/created on the host OLLAMA_BASE_URL points at
# (e.g. `ollama create nexus-4b -f Modelfile.nexus-mf`, or `ollama pull gemma3:4b`).
OLLAMA_MODEL=nexus-4b
# Big model used ONLY for an explicit deep-cot request (never a blanket swap — the 12B pins
# ~8GB and lags a 16GB host). `ollama create nexus-12b -f Modelfile.nexus-12b`.
OLLAMA_MODEL_DEEP=nexus-12b
# Last-resort model if OLLAMA_MODEL isn't pulled (custom Modelfile wiped by a reboot, etc.).
OLLAMA_MODEL_FALLBACK=gemma3:4b
#
# Deep-cot degradation chain (resolveModel in localLlmClient.ts):
#   OLLAMA_MODEL_DEEP (nexus-12b) -> gemma3:12b -> OLLAMA_MODEL (nexus-4b) -> OLLAMA_MODEL_FALLBACK (gemma3:4b)
# Non-deep requests: OLLAMA_MODEL -> OLLAMA_MODEL_FALLBACK.
