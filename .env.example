# --- Bot-side vars (used by the separate Discord bot repo, NOT this server) ---
DISCORD_BOT_TOKEN=
NEXUS_API_KEY=

# --- Server-side vars (used by THIS Nexus AI engine server) ---
# Ollama endpoint reachable from wherever this server is hosted (e.g. a Cloudflare Quick Tunnel
# to a local Ollama instance) — leave blank to disable real generation and use template fallback.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
