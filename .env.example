# --- Bot-side vars (used by the separate Discord bot repo, NOT this server) ---
DISCORD_BOT_TOKEN=
NEXUS_API_KEY=

# --- Server-side vars (used by THIS Nexus AI engine server) ---
# Ollama endpoint reachable from wherever this server is hosted (e.g. a Cloudflare Quick Tunnel
# to a local Ollama instance) — leave blank to disable real generation and use template fallback.
OLLAMA_BASE_URL=
# Main model. Requires `ollama pull gemma3:4b` on the host OLLAMA_BASE_URL points at.
OLLAMA_MODEL=gemma3:4b
# Larger model used only for the thorough/deep-cot reasoning-mode escalation (see
# modelForReasoningMode() in localLlmClient.ts) — not a blanket default swap. Requires this exact
# model already pulled (`ollama pull gemma3:12b`) on whatever host OLLAMA_BASE_URL points at.
OLLAMA_MODEL_DEEP=gemma3:12b
