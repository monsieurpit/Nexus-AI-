{
  "name": "pitcode",
  "displayName": "PitCode",
  "description": "Syntax colors, snippets and editing help for the PitCode language (.pit files)",
  "version": "1.0.0",
  "publisher": "pitcode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pitcode",
        "aliases": [
          "PitCode",
          "pitcode"
        ],
        "extensions": [
          ".pit"
        ],
        "firstLine": "^#!.*\\bpitcode\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pitcode",
        "scopeName": "source.pitcode",
        "path": "./syntaxes/pitcode.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pitcode",
        "path": "./snippets/pitcode.json"
      }
    ],
    "commands": [
      {
        "command": "pitcode.run",
        "title": "PitCode: Run this file",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pitcode.run",
          "when": "editorLangId == pitcode",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pitcode.run",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorLangId == pitcode"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pitcode"
  ]
}
